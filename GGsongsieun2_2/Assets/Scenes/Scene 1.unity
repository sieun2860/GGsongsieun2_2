--- !u!114 &298067500
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 298067499}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e2caff98c6d595458e0e313225b708d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uC870\uC218"
    text: "\uADF8\uB807\uAC8C \uB9D0\uC500\uD558\uC2E4 \uC904 \uC54C\uC558\uC5B4\uC694!"
    standingSpriteIndex: 1
  - speaker: "\uC870\uC218"
    text: "\uC758\uB8B0\uC778\uC740 40\uB300 \uC5EC\uC131\uC774\uC2DC\uACE0\uC694,
      \uC9D1\uC548 \uB300\uB300\uB85C \uB0B4\uB824\uC624\uB294 '\uC8FC\uB801\uC8FC\uB801
      \uB2E4\uC774\uC544\uBAAC\uB4DC \uBAA9\uAC78\uC774' \uB97C \uAE08\uACE0\uC5D0
      \uADC0\uD788 \uBCF4\uAD00\uD574\uB480\uB294\uB370 \uC5B4\uC82F\uBC24 \uAC10\uCABD\uAC19\uC774
      \uC0AC\uB77C\uC84C\uB2E4\uACE0 \uD574\uC694."
    standingSpriteIndex: 0
  - speaker: "\uC870\uC218"
    text: "\uB3C8\uC744 \uC5C4\uCCAD\uB098\uAC8C \uC8FC\uC2E0 \uBD84 \uB2F5\uAC8C,
      \uB3C4\uB09C\uB2F9\uD55C \uBB3C\uAC74\uB3C4 \uC5C4\uCCAD\uB09C \uACE0\uAC00\uC758
      \uBAA9\uAC78\uC774\uB798\uC694. \uD574\uACB0\uD558\uBA74 \uB354 \uC5B9\uC5B4\uC8FC\uC2E0\uB2E4\uACE0
      \uD588\uC5B4\uC694."
    standingSpriteIndex: 1
  - speaker: "\uD0D0\uC815"
    text: "\uADF8\uAC74 \uC548 \uAD81\uAE08\uD558\uB2C8\uAE4C \uC758\uB8B0 \uB0B4\uC6A9."
    standingSpriteIndex: 0
  - speaker: "\uC870\uC218"
    text: "\uB135."
    standingSpriteIndex: 0
  - speaker: "\uC870\uC218"
    text: "\uD558\uC5EC\uAC04 \uBAA9\uAC78\uC774\uB294 \uC5C4\uCCAD\uB098\uAC8C \uADC0\uD55C
      \uBB3C\uAC74\uC774\uB77C, \uD558\uB8E8\uBE68\uB9AC \uCC3E\uC9C0 \uC54A\uC73C\uBA74
      \uC5B4\uB514 \uD314\uB824\uB098\uAC08\uC9C0\uB3C4 \uBAB0\uB77C\uC11C \uC544\uC8FC\uC544\uC8FC
      \uAE09\uD558\uC2DC\uB300\uC694. "
    standingSpriteIndex: 4
  - speaker: "\uC870\uC218"
    text: "\uADF8\uB798\uC11C \uC6B0\uB9AC \uD574\uACB0\uB960 100%\uC758 \uD0D0\uC815\uB2D8\uAED8
      \uB3C8\uC744 \uB354\uBE14\uB85C \uC5B9\uC5B4 \uC8FC\uC2DC\uBA74\uC11C \uBD80\uD0C1\uD558\uC2E0
      \uAC70\uC8E0!"
    standingSpriteIndex: 1
  - speaker: "\uC870\uC218"
    text: "\uBBF8\uD574\uACB0 \uC0AC\uAC74 0\uAC1C! \uB9E1\uAE30\uB9CC \uD558\uBA74
      \uC0AC\uAC74\uC758 \uBC11\uBC14\uB2E5\uAE4C\uC9C0 \uC804\uBD80 \uD30C\uD5E4\uCCD0\uC8FC\uC2DC\uB294,
      \uD574\uACB0\uB960 \uBC31\uD504\uB85C, \uC544\uC8FC\uC544\uC8FC \uC720\uB2A5\uD55C
      \uC6B0\uB9AC \uB3C8\uC904 \uD0D0\uC815\uB2D8!"
    standingSpriteIndex: 1
  - speaker: "\uD0D0\uC815"
    text: "\uADF8\uB9CC."
    standingSpriteIndex: 0
  - speaker: "\uC870\uC218"
    text: "\uB124."
    standingSpriteIndex: 0
  - speaker: "\uC870\uC218"
    text: "\uB354 \uB4E4\uC73C\uC154\uC57C \uD560 \uC815\uBCF4\uB85C\uB294... \uBAA9\uAC78\uC774\uB97C
      \uAC00\uC838\uAC08 \uB9CC\uD55C \uC0AC\uB78C\uC774 \uC544\uC608 \uC9DA\uC774\uC9C0
      \uC54A\uB294\uB2E4\uB294 \uC810\uC774\uC5D0\uC694. \uC560\uCD08\uC5D0 \uAE08\uACE0\uC758
      \uC704\uCE58\uB97C \uC544\uB294 \uC0AC\uB78C\uC870\uCC28\uB3C4 \uBCC4\uB85C
      \uC5C6\uB2E4\uACE0 \uD558\uACE0\uC694. \uC218\uC218\uAED8\uB07C\uC8E0? "
    standingSpriteIndex: 4
  - speaker: "\uC870\uC218"
    text: "\uB0B4\uC6A9\uC740 \uC774\uAC8C \uB05D\uC774\uC5D0\uC694! \uC790, \uCD9C\uBC1C\uD569\uC2DC\uB2E4!"
    standingSpriteIndex: 1
  choice1: 
  choice2: 
  onChoice1:
    m_PersistentCalls:
      m_Calls: []
  onChoice2:
    m_PersistentCalls:
      m_Calls: []
  prompt: {fileID: 0}
  dialogueBox: {fileID: 1080523955}
  standingSprite: {fileID: 0}
