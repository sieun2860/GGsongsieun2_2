  - speaker: "\uC870\uC218"
    text: "\uC544, \uD0D0\uC815\uB2D8! \uC880 \uC26C\uC168\uC5B4\uC694?"
    standingSpriteIndex: 0
  - speaker: "\uD0D0\uC815"
    text: "\uC544\uB2C8."
    standingSpriteIndex: 0
  - speaker: "\uC870\uC218"
    text: "\uB300\uB2F5\uD560 \uD798\uC774 \uC0DD\uAE30\uC168\uAD70\uC694! \uADF8\uB7FC
      \uBC14\uB85C \uC758\uB8B0 \uB0B4\uC6A9 \uB9D0\uC500\uB4DC\uB9B4\uAC8C\uC694."
    standingSpriteIndex: 1
  - speaker: "\uD0D0\uC815"
    text: "\uD558..."
    standingSpriteIndex: 5
  - speaker: "\uC870\uC218"
    text: "\uD798 \uBE60\uC9C0\uAC8C \uD558\uC9C0 \uB9C8\uC138\uC694. \uC5B4\uCC28\uD53C
      \uC774\uBC88 \uAC74\uC740 \uBB34\uC870\uAC74 \uB9E1\uC73C\uC154\uC57C \uD558\uB2C8\uAE4C."
    standingSpriteIndex: 4
  - speaker: "\uD0D0\uC815"
    text: "\uBB34\uC870\uAC74\uC774 \uC5B4\uB514\uC788\uC5B4? "
    standingSpriteIndex: 0
  - speaker: "\uC870\uC218"
    text: "\uC758\uB8B0\uC778\uAED8\uC11C \uBC8C\uC368 \uB3C8\uC744 \uC8FC\uC168\uAC70\uB4E0\uC694."
    standingSpriteIndex: 1
  - speaker: "\uD0D0\uC815"
    text: "\uADF8\uAC78 \uBC1B\uC740\uAC74\uAC00?"
    standingSpriteIndex: 0
  - speaker: "\uC870\uC218"
    text: "\uB124."
    standingSpriteIndex: 0
  - speaker: "\uD0D0\uC815"
    text: ...
    standingSpriteIndex: 0
  - speaker: "\uC870\uC218"
    text: "\uAC70\uC808\uD558\uAE30\uC5D4 \uB108\uBB34 \uD070 \uB3C8\uC774\uC5C8\uB294\uAC78\uC694."
    standingSpriteIndex: 0
  - speaker: "\uD0D0\uC815"
    text: ...
    standingSpriteIndex: 0
  choice1: "\uC758\uB8B0 \uB0B4\uC6A9\uC774 \uBB54\uB370?"
