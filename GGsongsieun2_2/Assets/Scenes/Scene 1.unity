--- !u!114 &1850371506
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1850371505}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e2caff98c6d595458e0e313225b708d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: 
    text: "\uC544\uAE4C\uB3C4 \uC788\uC5C8\uB098? \uBC1C\uACAC\uD558\uC9C0 \uBABB\uD588\uB358
      \uC2E0\uBB38\uC774\uB2E4."
    standingSpriteIndex: 0
  - speaker: 
    text: "\"\uC783\uC5B4\uBC84\uB9B0 \uB2E4\uC774\uC544\uBAAC\uB4DC \uBAA9\uAC78\uC774,
      \uB2E8\uC21C \uCC45\uC815\uAC00\uB9CC 50\uC5B5?\""
    standingSpriteIndex: 0
  - speaker: 
    text: "\"\uB3C4\uB09C \uBCF4\uD5D8, 1\uB144\uB9CC \uB4E4\uC5B4 \uB450\uC5B4\uB3C4
      \uBCF4\uC0C1\uC774 \uBE75\uBE75\uD569\uB2C8\uB2E4!\""
    standingSpriteIndex: 0
  - speaker: 
    text: "\"\uC138\uAE30\uC758 \uAD34\uB3C4, \uB4DC\uD0A4... '\uC774\uBC88 \uC0AC\uAC74\uC740
      \uB098 \uC544\uB2C8\uC57C'\""
    standingSpriteIndex: 0
  - speaker: 
    text: "...\uBCC4\uB85C \uB3C4\uC6C0\uB418\uB294 \uC815\uBCF4\uAC00 \uC801\uD600\uC788\uC9C4
      \uC54A\uC740 \uAC83 \uAC19\uB2E4."
    standingSpriteIndex: 0
  choice1: 
  choice2: 
  onChoice1:
    m_PersistentCalls:
      m_Calls: []
  onChoice2:
    m_PersistentCalls:
      m_Calls: []
  prompt: {fileID: 134806835}
  dialogueBox: {fileID: 1080523955}
  standingSprite: {fileID: 0}
