--- !u!114 &1862418834
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1862418829}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e2caff98c6d595458e0e313225b708d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uC5D8\uB354"
    text: "\uB204\uAD6C\uC138\uC694? \uCC98\uC74C \uBCF4\uB294 \uC5BC\uAD74\uC778\uB370..."
  - speaker: "\uB098"
    text: "\uC5D8\uB354, \uC7A5\uB09C\uCE58\uC9C0 \uB9C8!"
  - speaker: "\uC5D8\uB354"
    text: "\uD558\uD558! \uB124\uAC00 \uC5EC\uAE38 \uCC98\uC74C\uBCF8\uB2E4\uB294
      \uB4EF\uD55C \uD45C\uC815\uC744 \uD558\uACE0 \uC788\uC796\uC544. \uBB34\uC2A8
      \uC77C\uC774\uC57C?"
  - speaker: "\uB098"
    text: "\uB108\uBB34 \uC2EC\uC2EC\uD574\uC11C, \uC8FC\uBCC0\uC744 \uC0C8\uB86D\uAC8C
      \uC5EC\uACA8\uBCF4\uAE30\uB85C \uD588\uC5B4. \uBAA8\uD5D8\uD558\uB294 \uAE30\uBD84\uC744
      \uC880 \uB0B4 \uBCF4\uB824\uACE0."
  - speaker: "\uC5D8\uB354"
    text: "\uADF8\uAC70 \uC88B\uB124. \uADF8\uB7FC \uB098\uB294 \uC5EC\uAE30\uC11C
      \uB110 \uAD6C\uACBD\uD558\uB294 \uB180\uC774\uB97C \uD574\uC57C\uACA0\uB2E4."
  - speaker: "\uB098"
    text: "\uC5D8\uB354, \uAC19\uC774 \uD560 \uC0DD\uAC01\uC740 \uC5C6\uC5B4?"
  - speaker: "\uC5D8\uB354"
    text: "\uC74C... \uADF8\uB7FC \uD68C\uC0C9 \uC9C0\uBD95 \uC9D1\uC758 \uC5F4\uC1E0\uB97C
      \uAC00\uC838\uB2E4 \uC904\uB798? \uC0AC\uC2E4 \uADF8\uAC78 \uCC3E\uB290\uB77C
      \uBABB \uB180\uACE0 \uC788\uB358 \uAC70\uAC70\uB4E0. \uB300\uC2E0 \uCC3E\uC544\uC8FC\uBA74,
      \uAC19\uC774 \uD560\uAC8C."
  choice1: "\uC88B\uC544! \uCC3E\uC544\uC62C\uAC8C."
  choice2: "\uB0B4\uAC00 \uADF8\uAC78 \uC5B4\uB5BB\uAC8C \uCC3E\uC544?"
  onChoice1:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 298067500}
        m_TargetAssemblyTypeName: Talk, Assembly-CSharp
        m_MethodName: Say
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 737681297}
        m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
        m_MethodName: SetActive
        m_Mode: 6
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  onChoice2:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 523560853}
        m_TargetAssemblyTypeName: Talk, Assembly-CSharp
        m_MethodName: Say
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
